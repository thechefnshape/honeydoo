# ---------- App ----------
APP_URL=http://localhost:3000
# Leave DATABASE_URL empty for local development: an embedded Postgres is created in .data/ and seeded automatically.
# Production: a managed Postgres connection string (e.g. Supabase "Session pooler" URI).
DATABASE_URL=
# true = demo shops visible, demo merchant sign-in and open admin page. MUST be false in production.
DEMO_MODE=true
# 32+ random characters. Signs merchant session cookies.  openssl rand -base64 32
SESSION_SECRET=
# 32 bytes, base64. Encrypts Square OAuth tokens at rest (AES-256-GCM).  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Bearer secret for the scheduled job endpoint POST /api/v1/internal/jobs
CRON_SECRET=
# Admin dashboard access uses staff accounts. Create the first owner with:
#   npm run admin:invite -- --email you@example.com --name "Your Name" --role owner
# Estimated Honeydoo variable cost per paid order, in cents (AI, infra, email). Used for contribution margin.
HONEYDOO_VARIABLE_COST_MINOR=8

# ---------- Square ----------
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
# Must exactly match the OAuth redirect URL registered in the Square Developer Console.
SQUARE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/square/callback
# From the webhook subscription in the Square Developer Console.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the webhook subscription URL (used in signature verification).
SQUARE_WEBHOOK_URL=https://YOUR-DOMAIN/api/v1/webhooks/square
SQUARE_API_VERSION=2026-09-16
# true = request PAYMENTS_WRITE_ADDITIONAL_RECIPIENTS and collect the merchant's $1 fee as a Square application fee.
SQUARE_COLLECT_APP_FEE=true

# ---------- AI search ----------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_REQUEST_LIMIT=5000

# Transactional email for password reset (Resend). Without it, reset links cannot be sent.
RESEND_API_KEY=
EMAIL_FROM="honeydoo <hello@honeydoo.com>"

# Search engines may index the site only when true. Keep false for staging, previews and until launch.
SITE_INDEXING=false
